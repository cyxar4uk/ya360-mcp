{
  "name": "ya360-mcp",
  "version": "0.2.1",
  "private": true,
  "description": "Неофициальный MCP-сервер для Яндекс Трекера, Почты и Календаря (Яндекс 360) — для Claude Code, Claude Desktop и других клиентов MCP",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "yandex",
    "yandex-360",
    "yandex-tracker",
    "imap",
    "caldav"
  ],
  "homepage": "https://github.com/cyxar4uk/ya360-mcp#readme",
  "bugs": {
    "url": "https://github.com/cyxar4uk/ya360-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyxar4uk/ya360-mcp.git"
  },
  "license": "MIT",
  "author": "Ilia Mel (https://github.com/cyxar4uk)",
  "type": "module",
  "bin": {
    "ya360-mcp": "src/main.mjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "PRIVACY.md"
  ],
  "scripts": {
    "start": "node src/main.mjs",
    "setup": "node src/main.mjs setup",
    "doctor": "node src/main.mjs doctor",
    "test": "node --test test/unit.test.mjs test/config.test.mjs test/oauth.test.mjs test/tools.test.mjs",
    "smoke": "node test/smoke.mjs",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "wiki:tools": "node scripts/wiki-tools.mjs",
    "wiki:sync": "node scripts/sync-wiki.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ical.js": "^2.2.1",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "tsdav": "^2.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "esbuild": "^0.28.2"
  }
}
