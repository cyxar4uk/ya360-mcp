# Справочник переменных окружения ya360-mcp.
# Обычно не нужен: настройки задаёт мастер (ya360-mcp setup) или поля плагина / расширения.
# Переменные главнее config.json. Пустая переменная не считается заданной.

# ── Общее
YANDEX_LOGIN=                 # полный адрес ящика: ivan@yandex.ru или адрес на домене организации
YANDEX_TZ=Europe/Moscow       # часовой пояс для дат
YANDEX_MCP_PERMISSIONS=read   # read | assist | full | группы: read,tracker.comment | full,-mail.send
# YANDEX_MCP_HOME=            # папка настроек вместо стандартной
# YANDEX_MCP_ACCOUNT=default  # имя набора секретов в хранилище ОС
# YANDEX_MCP_DOWNLOAD_DIR=    # куда сохранять вложения (по умолчанию — временная папка)

# ── Трекер
YANDEX_TRACKER_TOKEN=         # OAuth-токен с правами tracker:read, tracker:write
YANDEX_TRACKER_ORG_ID=        # ID организации Яндекс 360 (admin.yandex.ru)…
YANDEX_TRACKER_CLOUD_ORG_ID=  # …или Yandex Cloud (console.yandex.cloud) — одно из двух
# YANDEX_TRACKER_QUEUE=       # очередь по умолчанию
# YANDEX_TRACKER_BOARD=       # доска для спринтов по умолчанию
# YANDEX_TRACKER_ENV_FILE=    # взять TRACKER_TOKEN и TRACKER_(CLOUD_)ORG_ID из файла формата .env

# ── Почта (IMAP/SMTP) — пароль приложения типа «Почта»
YANDEX_MAIL_APP_PASSWORD=
# YANDEX_MAIL_FROM_NAME=Иван Иванов

# ── Календарь (CalDAV) — отдельный пароль приложения типа «Календарь»
YANDEX_CALENDAR_APP_PASSWORD=
# YANDEX_CALENDAR_DEFAULT=Мои события

# ── Вход через Яндекс (OAuth) вместо паролей
# YANDEX_OAUTH_TOKEN=         # готовый токен на все сервисы (без продления)
# YANDEX_OAUTH_CLIENT_ID=     # своё приложение oauth.yandex.ru — для ya360-mcp login и продления
# YANDEX_OAUTH_CLIENT_SECRET=
