# Скопируй в .env (рядом с этим файлом) и заполни. .env в git не попадает.
# Сервис без настроек просто не подключается — остальные работают.

# ── Общее
# Полный адрес ящика Яндекса (личный или домен организации в Яндекс 360)
YANDEX_LOGIN=
# Часовой пояс для дат в запросах и ответах
YANDEX_TZ=Europe/Moscow
# 1 — только чтение: инструменты отправки, записи и удаления не подключаются
YANDEX_MCP_READONLY=0
# Куда сохранять вложения писем (по умолчанию — временная папка системы)
# YANDEX_MCP_DOWNLOAD_DIR=C:/Users/me/Downloads/mail

# ── Трекер
# Вариант 1: взять токен и организацию из готового файла формата .env.tracker
#   (TRACKER_TOKEN, TRACKER_ORG_ID / TRACKER_CLOUD_ORG_ID)
# YANDEX_TRACKER_ENV_FILE=C:/Users/me/project/.env.tracker
# Вариант 2: задать напрямую. Токен: https://oauth.yandex.ru → приложение с правами tracker:read, tracker:write
# YANDEX_TRACKER_TOKEN=
# Одно из двух: ID организации Яндекс 360 (admin.yandex.ru) или Yandex Cloud (console.yandex.cloud)
# YANDEX_TRACKER_ORG_ID=
# YANDEX_TRACKER_CLOUD_ORG_ID=

# ── Почта (IMAP/SMTP)
# Пароль приложения типа «Почта»: id.yandex.ru → Безопасность → Пароли приложений.
# В настройках почты включить IMAP: Все настройки → Почтовые программы → «С сервера imap.yandex.ru по протоколу IMAP»
# и «Пароли приложений и OAuth-токены».
YANDEX_MAIL_APP_PASSWORD=
# Имя отправителя в письмах (необязательно)
# YANDEX_MAIL_FROM_NAME=Иван Иванов

# ── Календарь (CalDAV)
# Пароль приложения типа «Календарь» (это другой пароль, не почтовый)
YANDEX_CALENDAR_APP_PASSWORD=
# Календарь для новых событий по названию (по умолчанию — первый из списка)
# YANDEX_CALENDAR_DEFAULT=Мои события
